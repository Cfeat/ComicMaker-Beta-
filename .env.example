# Server-side credentials ONLY. They are read by the /api functions (Vercel)
# and the local dev proxy (vite.config.ts) — never bundled into the browser.
# Do NOT rename them with a VITE_ prefix: every VITE_* variable is exposed
# to anyone who opens the site.

# Google AI Studio key used for comic script generation
# (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Bearer token for the OpenAI-compatible API — used for image generation AND
# for GPT script models (chat/completions)
IMAGE_API_KEY=your_image_api_key

# Base URL of the image API (optional, defaults to https://api.guigesama.xyz/v1)
IMAGE_API_BASE_URL=https://api.guigesama.xyz/v1
